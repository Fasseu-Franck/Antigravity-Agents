# LinkedIn OAuth 2.0 Access Token
# Required scopes:
# - For personal posting: w_member_social, openid, profile, email
# - For company pages: w_organization_social, r_organization_social
LINKEDIN_ACCESS_TOKEN=your_linkedin_oauth_access_token_here

# (Optional) Default author URN (Person or Organization)
# Example: urn:li:person:abcdef123 or urn:li:organization:123456
LINKEDIN_AUTHOR_URN=

# (Optional) LinkedIn REST Version (Default: 202401)
LINKEDIN_API_VERSION=202401

# (Optional) Local path for scheduled posts queue file (Default: ./linkedin-queue.json)
LINKEDIN_QUEUE_FILE=./linkedin-queue.json

# (Optional) Server transport: stdio (default) or http
TRANSPORT=stdio

# (Optional) Port when running in HTTP mode (Default: 3000)
PORT=3000
